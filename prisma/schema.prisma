generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Prediction {
  id         Int      @id @default(autoincrement())
  filename   String
  prediction String
  confidence Float
  realClips  Int
  fakeClips  Int
  analysis String?
  createdAt  DateTime @default(now())
}